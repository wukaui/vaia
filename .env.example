# ===== LLM API =====
# DeepSeek 示例：https://api.deepseek.com
AGENT_MODEL=deepseek-flash
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx

# ⚠️ 推理模型的**思考 token 也算在 max_tokens 里**，默认值 3000 在送审提示词变长后
# 会被挤爆：实测 63 个文件里 4 个报 "Model token limit (3000) exceeded before any
# response was generated" —— 模型一个字都没生成出来，静默降级到规则判定，
# 其中 2 个降级成了 clean（假阴性）。调到 8000 仍有文件失败，16000 才稳。
AGENT_MAX_TOKENS=16000

# Qwen DashScope（中国区）示例：
# AGENT_MODEL=qwen3.8-flash
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx


# ===== 可选：VirusTotal（只按 hash 查询，不上传样本） =====
# VT_API_KEY=

# ===== 可选：状态目录（隔离区 / 白名单 / 历史 / Web 上传，默认 ~/ai-av-bench/ai-av-state）=====
# AI_AV_STATE_DIR=

# ===== 可选：capa 数据位置（默认 <项目根>/third_party/capa-{rules,sigs}，见 README）=====
# CAPA_RULES=
# CAPA_SIGS=
# CAPA_EXE=
