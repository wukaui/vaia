# ===== LLM API =====
# DeepSeek 示例：https://api.deepseek.com
AGENT_MODEL=deepseek-flash
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx

# 推理模型的思考 token 也算在 max_tokens 里，默认 3000 会挤爆 → 模型零输出 →
# 静默降级到规则判定。实测 8000 仍有文件失败，16000 才稳。
AGENT_MAX_TOKENS=16000

# Qwen DashScope（中国区）示例：
# AGENT_MODEL=qwen3.8-flash
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_API_KEY=sk-xxxxxxxxxxxxxxxx


# ===== 可选：VirusTotal（只按 hash 查询，不上传样本） =====
# VT_API_KEY=

# ===== 可选：状态目录（隔离区 / 白名单 / 历史 / Web 上传）=====
# 默认 ~/ai-av-bench/ai-av-state
# AI_AV_STATE_DIR=

# ===== 可选：capa（默认 <项目根>/third_party/capa-{rules,sigs}，装完跑 aiav capa-setup）=====
# CAPA_DATA=
# CAPA_RULES=
# CAPA_SIGS=
# CAPA_EXE=
# CAPA_TIMEOUT=180

# ===== 可选：其它 =====
# AI_AV_TOKEN_BUDGET=          # token 预算硬闸，超出降级为规则判定
# AI_AV_AGENT_SAMPLES=1        # AI 多次采样取多数票
# AI_AV_ENABLE_SHELL=          # 设 1 才把 shell 放进工具表
